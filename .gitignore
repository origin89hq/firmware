target/
*.bin
*.elf
*.map

# Except committed fixtures: bytes a generator really produced, which the
# readers of those formats are tested against. `*.bin` above is for build
# output, and a fixture is the opposite of build output.
!crates/o89-dev/fixtures/*.bin
# And the module's bootloader, built from ESP-IDF by `just comms-bootloader`
# with its configuration beside it (F-088): what the bench flashes, and what
# the slot route requires a module to hold.
!firmwares/o89-comms/bootloader/*.bin
.DS_Store
bench-logs/

# Local credentials
.env
.env.*
!.env.example

# The shared skills cache and its links; `just skills-sync` writes them.
/.origin89/engineering/
/.agents/skills/origin89-*
/.claude/skills/origin89-*
